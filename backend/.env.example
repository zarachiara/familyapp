# Application Environment
APP_ENV=development
PORT=8000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/familyflow?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-characters-long-change-this-in-production
JWT_EXPIRES_IN=604800

# CORS Origins (comma-separated)
# Add your production frontend URL here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://familyapp-nvvp.onrender.com

# Email Configuration (Brevo)
BREVO_API_KEY=your-brevo-api-key-here
SENDER_EMAIL=noreply@fairshare.app
SENDER_NAME=FairShare